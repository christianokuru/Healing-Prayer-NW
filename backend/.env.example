# Copy to .env for local development.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hpn:hpn@127.0.0.1:5433/hpn
# Tests wipe this one. Only this line of .env is read by the tests.
TEST_DATABASE_URL=postgresql+psycopg://hpn:hpn@127.0.0.1:5433/hpn_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-please
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# The API's own host names, as JSON. Required in production.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
MINISTRY_ADDRESS=

# Leave SMTP_HOST empty in development: emails are printed by the worker.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) or ssl (port 465). "none" only for a local mail catcher.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
# The ministry's inbox: visitors' replies go here. Required in production.
EMAIL_REPLY_TO=prayer@example.com
