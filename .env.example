# Copy to .env.local for local development.

# mock: demo data kept in the browser, no backend needed (the default).
# live: the FastAPI backend in backend/, through this site's /api bridge.
NEXT_PUBLIC_API_MODE=mock

# Where this Next.js server reaches FastAPI (server-side only, never sent to browsers).
API_URL=http://127.0.0.1:8000
